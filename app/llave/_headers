# La llave de paso · cabeceras para despliegue independiente en Netlify.
# El service worker y la portada no se cachean en el CDN: una versión nueva
# llega al instante (el precache interno ya se ocupa del offline).
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Seguridad + RGPD. La CSP bloquea cualquier recurso externo, así que la IP
# del paciente nunca sale hacia terceros aunque un día se colara un enlace.
/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'
