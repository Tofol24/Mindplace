{
  "name": "Pizarra del entrenador · APRENS",
  "short_name": "Pizarra",
  "description": "Pizarra táctica y cuaderno del entrenador. Los jugadores ven dónde juegan y qué hacer en cada jugada.",
  "lang": "es",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F4F2EC",
  "theme_color": "#14281D",
  "icons": [
    { "src": "../entrenador/aprens-icona-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "../entrenador/aprens-icona-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "../entrenador/aprens-icona-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "files": [
        { "name": "archivo", "accept": ["text/html", ".html", ".htm", "text/plain", ".txt", "application/json", ".json"] }
      ]
    }
  }
